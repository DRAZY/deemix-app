{
  "name": "deemix-app",
  "version": "1.10.12",
  "description": "Modern Deezer music downloader",
  "author": {
    "name": "Team MAXIMUS",
    "email": "noreply@deemix.app"
  },
  "homepage": "https://deemix.app",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:vite": "vite build",
    "build:mac": "vite build && electron-builder --mac --universal",
    "build:win": "vite build && electron-builder --win --x64",
    "build:win-arm64": "vite build && electron-builder --win --arm64",
    "build:linux": "vite build && PATH=\"$PWD/scripts/build-tools:$PATH\" electron-builder --linux --x64",
    "build:linux-arm64": "vite build && PATH=\"$PWD/scripts/build-tools:$PATH\" electron-builder --linux --arm64",
    "build:mac-arm64": "vite build && electron-builder --mac --arm64",
    "build:all": "vite build && electron-builder --mac --universal && electron-builder --mac --arm64 && electron-builder --win --x64 && electron-builder --win --arm64 && PATH=\"$PWD/scripts/build-tools:$PATH\" electron-builder --linux --x64 && PATH=\"$PWD/scripts/build-tools:$PATH\" electron-builder --linux --arm64",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"electron .\""
  },
  "dependencies": {
    "axios": "^1.15.2",
    "egoroof-blowfish": "^4.0.2",
    "flac-metadata": "^0.1.1",
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9",
    "pinia": "^2.1.0",
    "socket.io-client": "^4.7.0",
    "vue": "^3.5.32",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.10",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.2",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vue-tsc": "^3.2.1"
  },
  "overrides": {
    "lodash": "^4.18.0",
    "@xmldom/xmldom": "^0.8.13",
    "ip-address": "^10.1.1",
    "follow-redirects": "^1.16.0",
    "engine.io-client": "^6.6.5"
  },
  "build": {
    "appId": "app.deemix.remastered",
    "productName": "Deemix Remastered",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "category": "Audio"
    }
  }
}
